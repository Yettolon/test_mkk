DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments  # pragma: allowlist secret
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/  # pragma: allowlist secret
API_KEY=dev-secret  # pragma: allowlist secret
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=50
WEBHOOK_TIMEOUT=5
CONSUMER_ATTEMPTS=3

# Postgres settings
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
